{% extends 'base.html.twig' %}
{% block title_page %}
    <h2>Détail d'une Matière</h2>
{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-6 justify-content-center">
                 <div class="card">
                    <div class="card-header">
                    </div>
                    <div class="card-body">
                        <div class="col-lg-6">
                            <h3>Nom: {{ subject.name }}</h3>
                        </div>
                        <div class="col-lg-6">
                            <h3>Enseignant: {{ subject.teacher.lastname }} {{ subject.teacher.firstname }}</h3>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
{% endblock %}
